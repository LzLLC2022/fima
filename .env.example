# ============================================================
# FiMa-Inv — 환경변수 설정 템플릿
# ============================================================
# 이 파일을 복사하여 .env.local 을 만들고 실제 값을 입력하세요.
# Vercel 배포 시: 프로젝트 → Settings → Environment Variables 에서 입력
# ============================================================

# Google Spreadsheet ID
# Google Sheets URL: https://docs.google.com/spreadsheets/d/[여기]/edit
GOOGLE_SHEET_ID=your_spreadsheet_id_here

# Google 서비스 계정 이메일
# Google Cloud Console → IAM → 서비스 계정 → 이메일 주소 복사
GOOGLE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# Google 서비스 계정 비공개 키 (PEM 형식, 줄바꿈은 \n 으로 표현)
# Google Cloud Console → 서비스 계정 → 키 → JSON 키 생성 후
# JSON 파일의 "private_key" 값을 그대로 붙여넣기
GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEo...(생략)...\n-----END RSA PRIVATE KEY-----\n"

# ── 외부 cron 인증 (이메일 리포트 / 텔레그램 알림 공용) ──
# GitHub Actions 가 /api/report/email, /api/watchlist/alert 호출 시 Bearer 토큰
REPORT_SECRET=any_random_secret_string

# ── 관심종목 변동 알림 (텔레그램) ──
# Telegram BotFather 에서 봇 생성 후 토큰을 입력 (모든 Owner 공유)
TELEGRAM_BOT_TOKEN=123456789:ABC-DEF...
#
# (선택) Webhook secret_token — 봇이 /start /myid 응답을 위해 받는 webhook 의 신뢰성 검증용.
# setWebhook 호출 시 secret_token 파라미터로 등록한 값과 동일해야 함.
# 미설정 시 webhook 인증 검증 스킵 (보안상 권장 X).
TELEGRAM_WEBHOOK_SECRET=random_long_string_here
#
# 사용자별 chat_id / 수신여부 / 임계값(상승/하락 %) 은 환경변수가 아니라
# 각 Owner의 Google Spreadsheet **Master 시트** 의 다음 4개 컬럼에서 관리:
#   Telegram (chat_id), TelegramRecv (Y/N), TelegramUpPct (숫자%), TelegramDownPct (숫자%)
# 앱의 ⚙️ 정보 변경 화면에서 입력하면 자동으로 시트에 저장됨 (헤더 없으면 자동 생성).
# 사용자는 봇과의 1:1 대화에서 /start 를 입력하면 봇이 본인 chat_id 를 자동 안내.
